# Godot 4+ specific ignores
.godot/
/android/

# Exported builds (see export_presets.cfg)
builds/

# .NET build artefacts
bin/
obj/
*.user

# Offline tooling intermediates (see the READMEs in each)
tools/dice-render/build/
tools/screenshots/build/

# CC0 source model for the die: ~22 MB, re-downloadable from Blend Swap #82440.
# The licence page that ships with it IS committed, as the record of the grant.
assets/*.zip
assets/**/*.blend

tools/dice-render/__pycache__

# Theme lab output: comparison pages, regenerated by tools/theme-lab
tools/theme-lab/out/

# Audio preview: waveform/spectrogram sheet, regenerated by tools/audio-render
tools/audio-render/out/

# Clip lab output: seam and readability strips, regenerated by tools/clip-lab
tools/clip-lab/out/

# Assembled by tools/web-port/assemble.py — never committed (ROADMAP 9).
build/
