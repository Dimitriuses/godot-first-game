; Engine configuration file.
;
; The GDScript tree's project file. It is NOT the C# one with a section removed --
; keep the two in step by hand, deliberately, because the differences are the point:
;
;   * no [dotnet] section, and no "C#" in config/features;
;   * main_scene by path rather than by uid, because the scenes in a build are
;     rewritten copies and their uids are regenerated with them.
;
; Everything else must match ../project.godot exactly or the two trees render
; differently and the screenshot parity gate (ROADMAP 9d) fails for a reason that has
; nothing to do with the port.

config_version=5

[application]

config/name="First Game"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"

[audio]

; **This is why the web build was silent, and it is a one-line difference from the C#
; tree that no headless test could have found.**
;
; Godot has two playback paths. "Stream" mixes in the engine and hands one buffer to the
; platform — what every desktop build does, and what every harness here exercises.
; "Sample" hands the clip to the platform to play, and on the web that means a Web Audio
; AudioBufferSourceNode routed through a splitter, per-channel gains and a merger into
; the bus node. **Godot defaults the web export to Sample** (`default_playback_type.web`
; ships as 1) while everything else defaults to Stream, so the web build was the only
; place this path ran at all.
;
; Measured on the deployed page with Playwright: the AudioContext reached 'running', the
; buffer source produced signal (peak 0.059 at the node), a tone injected straight into
; the bus gain came out at full strength — and every node between the two passed nothing.
; The sample path simply did not carry to the bus this game creates at runtime.
;
; 0 puts the web build on the same path as the desktop one, which is also the path all
; 60 local checks cover. If sample playback is ever wanted back, it needs a browser test
; to go with it: `python tools/web-port/browser_check.py` is that test.
general/default_playback_type.web=0

[filesystem]

import/blender/enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
